rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownerUidIsValid(uid) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function updatedByIsValid() {
      return request.resource.data.updatedBy == request.auth.uid;
    }

    function immutableOwnerUid() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function updatedAtMonotonic() {
      return request.resource.data.updatedAt is int
        && (resource == null || resource.data.updatedAt == null
          || request.resource.data.updatedAt >= resource.data.updatedAt);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && ownerUidIsValid(uid)
        && updatedByIsValid()
        && updatedAtMonotonic();

      allow update: if isOwner(uid)
        && immutableOwnerUid()
        && updatedByIsValid()
        && updatedAtMonotonic();

      allow delete: if false;

      match /gameData/{docId} {
        allow read: if isOwner(uid) && docId == "gameState";

        allow create: if isOwner(uid)
          && docId == "gameState"
          && ownerUidIsValid(uid)
          && updatedByIsValid()
          && updatedAtMonotonic();

        allow update: if isOwner(uid)
          && docId == "gameState"
          && immutableOwnerUid()
          && updatedByIsValid()
          && updatedAtMonotonic();

        allow delete: if false;
      }
    }
  }
}
